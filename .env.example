# Copia este archivo a .env (sin .example) y reemplaza los valores.
# IMPORTANTE: las variables DEBEN empezar con EXPO_PUBLIC_ para que Expo
# las inyecte en el cliente.

EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...REEMPLAZA_CON_TU_KEY

# El mapa de partidos y el autocompletado de direcciones. Sin esto el mapa
# web no se dibuja (la lista y los filtros siguen funcionando).
EXPO_PUBLIC_MAPBOX_TOKEN=pk.REEMPLAZA_CON_TU_TOKEN

# Informes de error (Sentry). OPCIONAL: sin esto la app funciona igual y no
# manda nada a ninguna parte. Déjalo tal cual y seguirá apagado: el marcador
# no se toma por un DSN válido a propósito.
# Tampoco se manda nada en desarrollo, aunque lo completes.
EXPO_PUBLIC_SENTRY_DSN=https://REEMPLAZA_CON_TU_DSN@oXXXX.ingest.sentry.io/XXXX
